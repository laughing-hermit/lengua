+++ b/src/util/scoped_timer.cpp
@@ -31,7 +31,7 @@ Revision History:
 #include <mutex>
 #include <thread>
 #include <vector>
-#ifndef _WINDOWS
+#if !defined(_WINDOWS) && !defined(__wasi__)
 #include <pthread.h>
 #endif

@@ -119,7 +119,7 @@ scoped_timer::~scoped_timer() {
 }

 void scoped_timer::initialize() {
-#ifndef _WINDOWS
+#if !defined(_WINDOWS) && !defined(__wasi__)
     static bool pthread_atfork_set = false;
     if (!pthread_atfork_set) {
         pthread_atfork(finalize, nullptr, nullptr);
